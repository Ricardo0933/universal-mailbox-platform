# ---------------------------------------------------------------------------
# Universal Mailbox Connection Platform :: environment configuration
# Copy to .env and fill in. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public URL of the API server. OAuth redirect URIs are derived from this as
# <PUBLIC_URL>/api/oauth/<google|microsoft>/callback and must match what you
# register with each provider exactly. Gmail and Google Workspace share the
# google callback; Outlook and Microsoft 365 share the microsoft callback.
PUBLIC_URL=http://localhost:4000

# Where the browser-facing UI runs. In development this is the Vite dev server.
APP_URL=http://localhost:5173

DATABASE_PATH=./data/mailbox.sqlite

# 32-byte key used to encrypt OAuth tokens at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Bootstrap dashboard administrator, created on first run.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Google (Gmail + Google Workspace) ------------------------------------
# https://console.cloud.google.com/apis/credentials
# Enable the Gmail API, then create a Web application OAuth client with
# redirect URI <PUBLIC_URL>/api/oauth/google/callback
# Scopes: openid email profile https://www.googleapis.com/auth/gmail.readonly
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Microsoft (Outlook + Microsoft 365) ----------------------------------
# https://portal.azure.com -> Entra ID -> App registrations
# Redirect URI: <PUBLIC_URL>/api/oauth/microsoft/callback
# Delegated Graph permissions: openid email profile offline_access User.Read Mail.Read
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# "common" supports both work/school and personal accounts.
MICROSOFT_OAUTH_TENANT=common
